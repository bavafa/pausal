{
  "name": "pausall",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "oxlint",
    "test": "vitest run",
    "decide": "node packages/pipeline/src/decide-cli.ts",
    "secrets": "secretlint \"**/*\"",
    "prepare": "git config core.hooksPath .githooks || true",
    "abo": "node packages/pipeline/src/catalog-cli.ts",
    "analyze": "node packages/pipeline/src/analyze-cli.ts",
    "vlm-check": "node packages/pipeline/src/vlm-check-cli.ts",
    "eval": "node packages/pipeline/src/eval-cli.ts",
    "browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@types/node": "26.6.6",
    "oxlint": "1.95.0",
    "secretlint": "14.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
