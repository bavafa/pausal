# Copy to .env and fill in. Never commit .env.
# Alibaba Model Studio key, Singapore (international) region
DASHSCOPE_API_KEY=
# Workspace OpenAI-compatible endpoint from Model Studio, Settings, Workspaces (sk-ws- keys only work there)
DASHSCOPE_BASE_URL=
# TypeSafe Jev key
TYPESAFE_API_KEY=

# Cloudflare R2 for product images (see docs/r2-setup.md)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pausal-images
R2_PUBLIC_URL=
